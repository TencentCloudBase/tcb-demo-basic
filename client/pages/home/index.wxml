<view class="tcb-srcoll-box">
  <view class="nav_bar_customize_top">
    <navBar title-text="" background="transparent" color="#fff" back-icon="" home-icon="" backImg="" bindback="back"/>
  </view>

  <view class="tcb-container home-scroll" style="margin-top: -{{navHeight}}px;">
    <view class="banner" style="padding-top: {{navHeight}}px;">
      <view class="hero-section">
        <view class="hero-brand">云开发</view>
        <view class="hero-title">AI 写代码，云开发管后端</view>
        <view class="hero-desc">小程序场景下体验云开发：数据库、云函数、支付等。同一套后端也覆盖 Web。</view>
        <view class="hero-actions">
          <button class="cb-btn cb-btn--primary hero-btn" bindtap="goExperience">体验云开发能力</button>
          <button class="cb-btn cb-btn--ghost hero-btn" bindtap="goDev">用 AI 加速</button>
        </view>
      </view>
    </view>

    <view class="home-container">
      <view class="home-section">
        <view class="home-section__head">
          <view class="home-section__title">产品体验</view>
          <view class="home-section__tip">{{product.tip}}</view>
        </view>
        <view class="feature-grid">
          <view
            wx:for="{{product.advantage}}"
            wx:key="title"
            class="feature-tile {{item.url ? 'feature-tile--accent' : ''}}"
            bindtap="onFeatureTap"
            data-navigatetype="{{item.navigateType}}"
            data-url="{{item.url || ''}}"
          >
            <image class="feature-tile__icon" src="{{item.coverImage}}"></image>
            <view class="feature-tile__title">{{item.title}}</view>
            <view class="feature-tile__desc">{{item.description}}</view>
            <view wx:if="{{item.url}}" class="feature-tile__cta">立即体验</view>
          </view>
        </view>

        <view class="schematic">
          <view class="schematic__meta">
            <view class="schematic__label">产品示意</view>
            <view class="schematic__desc">{{product.schematic.description}}</view>
          </view>
          <image class="schematic__img" mode="widthFix" src="{{product.schematic.coverImage}}"></image>
        </view>

        <button
          class="cb-btn cb-btn--ghost-dark more-btn"
          data-navigatetype="{{product.navigateType}}"
          data-url="{{product.url}}"
          bindtap="navigateToHandler"
        >打开微信云开发官网</button>
      </view>

      <view class="home-section">
        <view class="home-section__head">
          <view class="home-section__title">用 AI 开发</view>
        </view>
        <view class="ai-panel" wx:for="{{aiPaths}}" wx:key="title" bindtap="goPath" data-url="{{item.url}}">
          <view class="ai-panel__body">
            <view class="ai-panel__title">{{item.title}}</view>
            <view class="ai-panel__desc">{{item.description}}</view>
          </view>
          <view class="ai-panel__go">去安装</view>
        </view>
      </view>

      <view class="home-section">
        <view class="home-section__head">
          <view class="home-section__title">帮助与服务</view>
        </view>
        <view class="help-panel">
          <view
            class="help-row"
            wx:for="{{helpList}}"
            wx:key="title"
            wx:for-item="help"
            bindtap="navigateToHandler"
            data-navigatetype="{{help.navigateType}}"
            data-appid="{{help.appId || ''}}"
            data-url="{{help.url || ''}}"
          >
            <image class="help-row__icon" src="{{help.coverImage}}"></image>
            <view class="help-row__body">
              <view class="help-row__title">{{help.title}}</view>
              <view class="help-row__desc">{{help.description}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="home-footer">
        <view class="show_privacy" bindtap="showPrivacyWin">《小程序服务声明》</view>
        <trd-privacy id="trdPrivacy" name="云开发体验小程序" date="2026年7月23日" winStyle="{{winStyle}}"></trd-privacy>
        <view class="copyright">微信云开发</view>
      </view>
    </view>
  </view>
</view>
