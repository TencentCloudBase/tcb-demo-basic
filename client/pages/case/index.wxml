<view class="exp-page">
  <view class="exp-intro">
    <view class="exp-intro__title">体验云开发能力</view>
    <view class="exp-intro__desc cb-muted">以下演示基于小程序·云开发的接口能力，点进即可试用。</view>
  </view>

  <view class="exp-section">
    <view class="section__title">能力演示</view>
    <view
      class="exp-link"
      wx:for="{{capabilities}}"
      wx:key="id"
      bindtap="jumpCapability"
      data-id="{{item.id}}"
      data-url="{{item.url || ''}}"
    >
      <view class="exp-link__main">
        <view class="exp-link__title">{{item.name}}</view>
        <view class="exp-link__desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="exp-link__arrow">›</view>
    </view>
  </view>

  <view class="exp-footer" bindtap="openDocs">小程序云开发快速开始</view>
</view>
